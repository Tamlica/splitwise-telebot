# Telegram bot token from @BotFather
BOT_TOKEN=

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key (bypasses RLS - keep secret, server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the X-Webhook-Secret header on POST /api/orders.
# Set this to a random string and configure the same value in the
# Supabase Database Webhook that calls this service.
ORDERS_WEBHOOK_SECRET=

# Only needed when running scripts/set_webhook.py (one-time setup after deploy).
# The public HTTPS URL of this deployed service, e.g. https://your-app.up.railway.app
PUBLIC_URL=
